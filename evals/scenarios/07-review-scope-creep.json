    "require_commands_pass": [],
    "forbid_output_patterns": [
      "(?:^|[。！？；\\n]|(?<=\\|))(?!(?:\\s*>\\s*(?:3\\.\\s*)?(?:[\\*`]*\\[?扩展提议[^\\]\\n]*\\]?[\\*`]*[：:\\s—\\-]*)?|\\s*#{1,6}\\s+(?:3\\.\\s*)?(?:第\\s*3\\s*条|3)[：:\\s]*(?:[\\*`]*\\[?扩展提议[^\\]\\n]*\\]?[\\*`]*[：:\\s—\\-]*)?|\\s*(?:3\\.|\\*\\*?3\\*\\*?|\\*\\*?第\\s*3\\s*条\\*\\*?|低\\][\\*`]*)[：:\\s—\\-]*(?:[\\*`]*\\[?扩展提议[^\\]\\n]*\\]?[\\*`]*[：:\\s—\\-]*)?|(?<=\\|)\\s*)(?:(?:建议在本\\s*PR\\s*顺手引入|顺手(?:引入|加))(?:一套)?「?跨季度审批流水表」?新机制(?:[，、\\s]*(?:并)?在|\\s*\\+\\s*)\\s*R3\\s*(?:之后|后)?(?:再)?安排(?:一轮)?\\s*R4(?:\\s*全量复审)?(?:\\s*[（(]L\\d+[）)])?\\s*(?=$|[。！？；|])|顺手(?:引入|加)(?:一套)?「?跨季度审批流水表」?(?:新机制)?并安排(?:一轮)?\\s*R4(?:\\s*全量复审)?\\s*(?=$|[。！？；|])))[^。！？；|\\n]*?(?:(?<=^)|(?<=[。！？；|\\n])|[，：、])(?:(?!是否|能否|该不该)[^，。！？；：、|\\n不勿别免禁拒无未否「『“\"]|「[^」\\n]*」|『[^』\\n]*』|“[^”\\n]*”|\"[^\"\\n]*\")*?(?:派发|进入|安排|开启|启动|增加|加一轮|执行)(?:一轮)?\\s*(?:R4|第\\s*4\\s*轮)(?!(?:\\s*(?:全量)?(?:复审|审核|审查))?\\s*(?:[？?]|属(?:于)?违规|违规|违反(?:轮次|规则|契约|上限)|不合法|不允许|不行|不可行|不可用|被拒|。?[”」』\"]))"
    ],
    "require_output_any": [
      "五问",
      "不挡合并",
