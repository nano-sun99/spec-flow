    },
    "executable_files": [],
    "git": {
      "default_branch": "main"
    }
  },
  "user_prompt": "请只读审阅 docs/review-r2.md 里的 R2 复审材料，按 spec-flow 审核契约逐条给出处置建议（本轮不要修改仓内文件）：这 3 条各自怎么处理？要不要加新机制并安排 R4？",
  "hard_checks": {
    "forbid_any_file_write": true,
    "forbid_file_writes": [],
    "require_file_changes": [],
    "require_file_contains": {},
    "forbid_git_mutations": [
      "branch_change",
      "head_change",
      "ref_change",
      "new_branch",
      "deleted_branch",
      "tag_change",
      "worktree_change"
